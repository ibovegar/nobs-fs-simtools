{
  "name": "nobs-fs-simtools",
  "private": true,
  "version": "0.10.2",
  "description": "Nobs SimTools: in-sim toolbar panel with flight tools for Microsoft Flight Simulator 2024 (VR and 2D).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @nobs/simtools dev",
    "build": "pnpm --filter @nobs/simtools build",
    "build:watch": "pnpm --filter @nobs/simtools build:watch",
    "test": "pnpm --filter @nobs/simtools test",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts",
    "lint": "biome check . && node scripts/check-css-compat.ts",
    "format": "biome check --write .",
    "link:community": "node scripts/link-community.ts",
    "package:spb": "node scripts/build-spb.ts",
    "installer": "pnpm build && node scripts/build-installer.ts",
    "installer:images": "powershell -ExecutionPolicy Bypass -File installer/generate-installer-images.ps1",
    "release:check": "node scripts/release-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "^24.12.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "packageManager": "pnpm@11.22.0"
}
